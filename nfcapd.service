[Unit]
Description=NetFlow Capture Daemon for SG-1000 Integration
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/bin/mkdir -p /var/cache/netflow
ExecStart=/usr/bin/nfcapd -p 2055 -w /var/cache/netflow -t 60 -u netflow -x "/usr/local/bin/soc_analyst -d 3 %%d/%%f"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

