[Unit]
Description=NetFlow Capture Daemon for SG-1000 Integration
After=network.target soc_analyst.service
Requires=soc_analyst.service

[Service]
Type=simple
User=root
ExecStartPre=/bin/mkdir -p /var/cache/netflow
ExecStart=/usr/bin/nfcapd -p 2055 -w /var/cache/netflow -m /var/tmp/netflow_metrics.sock -u netflow -e
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

